{
  "name": "gharplan-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @gharplan/web dev",
    "lint": "eslint apps/web/src apps/web/vite.config.ts packages/geometry/src packages/core-model/src packages/core-model/scripts vitest.config.ts eslint.config.mjs",
    "typecheck": "tsc --project tsconfig.json && pnpm --recursive typecheck",
    "test": "vitest run",
    "schema:generate": "node packages/core-model/scripts/generate-schema.mjs",
    "schema:check": "node packages/core-model/scripts/generate-schema.mjs --check",
    "check": "pnpm schema:check && pnpm lint && pnpm typecheck && pnpm test",
    "build": "pnpm --filter @gharplan/web build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "jsdom": "30.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
