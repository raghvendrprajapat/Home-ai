      "earliestTask": "PH0-T02",
      "description": "Close a 699 x 699 square (e.g. a shaft): room kept, warning shown.",
      "plan": {
        "junctions": [
          { "id": "j1", "x": 0, "y": 0 },
          { "id": "j2", "x": 699, "y": 0 },
          { "id": "j3", "x": 699, "y": 699 },
          { "id": "j4", "x": 0, "y": 699 }
