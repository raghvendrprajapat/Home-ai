          { "id": "w3", "a": "j3", "b": "j4", "thickness": 200, "height": 3000 }
        ]
      },
      "operation": { "op": "addWall", "from": [0, 699], "to": [0, 0], "thickness": 200, "height": 3000 },
      "expect": {
        "accepted": true,
        "faceCount": 1,
        "faces": [
          {
            "corners": [[0, 0], [699, 0], [699, 699], [0, 699]],
